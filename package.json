{
  "name": "workincafe",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node tools/db-migrate.mjs",
    "db:seed:dev": "node tools/seed-dev.mjs",
    "ingest:overture": "tsx tools/ingest-overture.mts",
    "import:service-area": "tsx tools/import-service-area.mts",
    "create-operator": "node --experimental-strip-types tools/create-operator.mjs",
    "db:test": "vitest run --config vitest.integration.config.ts",
    "auth:schema:generate": "auth generate --config ./lib/auth/config.ts --output ./lib/db/schema/auth.generated.ts --yes && node tools/apply-auth-header.mjs",
    "policy:check": "bash tools/governance-check.sh && node tools/check-dependencies.mjs",
    "security:check": "node tools/check-security-advisories.mjs",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run policy:check && npm run security:check && npm run test"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.6.25",
    "better-auth": "1.6.25",
    "drizzle-orm": "0.45.2",
    "next": "16.2.12",
    "pg": "8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "auth": "1.6.25",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  }
}
