#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
cd "$ROOT"

ONLY_ARGUMENTS=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --only|--ui-only)
      [ "$#" -ge 2 ] || { echo "$1 requires Target/Suite" >&2; exit 2; }
      ONLY_ARGUMENTS="$ONLY_ARGUMENTS -only-testing:$2"
      shift 2
      ;;
    *)
      echo "Unknown argument: $1" >&2
      exit 2
      ;;
  esac
done

SIMULATOR_ID=$(xcrun simctl list devices available \
  | sed -nE 's/^[[:space:]]*iPhone[^()]*(\(([0-9A-F-]{36})\))[[:space:]]+\((Booted|Shutdown)\).*/\2/p' \
  | head -n 1)

if [ -z "$SIMULATOR_ID" ]; then
  echo "No available iPhone simulator is installed." >&2
  exit 1
fi

scripts/ios-generate
mkdir -p .artifacts/ios-tests
RESULT_BUNDLE=".artifacts/ios-tests/WorkInCafe-$(date +%Y%m%d-%H%M%S).xcresult"

# Intentional word splitting: each validated value becomes one xcodebuild flag.
# shellcheck disable=SC2086
xcodebuild test \
  -project ios/WorkInCafe.xcodeproj \
  -scheme WorkInCafe \
  -destination "platform=iOS Simulator,id=$SIMULATOR_ID" \
  -resultBundlePath "$RESULT_BUNDLE" \
  $ONLY_ARGUMENTS
