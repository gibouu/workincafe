# WorkinCafe environment variables.
# Local dev: copy to `.env.local` (gitignored). Deploys: set these in the Vercel
# dashboard, per environment. NEVER commit real secrets.

# Pooled application connection — Server Components / use cases read through this
# (Decision 5/6: one pooled pool per runtime).
#   Local dev: the disposable Docker PostGIS container.
#   Production: the Neon POOLED string (host contains `-pooler`).
DATABASE_URL=postgres://wic:wic@127.0.0.1:5433/wic_test

# Direct (non-pooled) connection — used ONLY by migrations (`db:migrate`) and the
# Vercel build's migration step. Never exposed to generation/lint/typecheck
# (Decision 7). Production: the Neon DIRECT string (no `-pooler`). The Neon-Vercel
# integration sets this as DATABASE_URL_UNPOOLED; migrations accept either name.
DATABASE_URL_DIRECT=postgres://wic:wic@127.0.0.1:5433/wic_test

# Tier 2 integration tests (`npm run db:test`) — MUST be a disposable LOCAL db
# (enforced by lib/db/testing/local-guard). Never a hosted/production database.
DATABASE_URL_TEST=postgres://wic:wic@127.0.0.1:5433/wic_test
